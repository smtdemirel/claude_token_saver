# .claudeignore — advisory hints for Claude Code
# Files listed here are de-prioritized in proactive scanning.
# Claude can still read them if explicitly asked.
#
# IMPORTANT: After editing, Claude Code picks this up automatically.
# No rebuild needed.

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
_build/
target/release/
target/debug/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
vendor/
.dart_tool/
.pub-cache/
Pods/

# ── Python generated ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/
.coverage
htmlcov/
lcov.info
*.lcov

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── Binaries and generated data ───────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.zip
*.tar.gz
*.gz
*.wasm

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.iml

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Lock files (large, rarely useful to read) ────────────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml
Cargo.lock
poetry.lock
Pipfile.lock
pubspec.lock
